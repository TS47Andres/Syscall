# Replace this sample with an API URL reachable from your app:
# Physical phone: your computer's LAN IP; Android emulator: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000; remote device: your public HTTPS API host
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Set after linking with an Expo/EAS project to register push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=
