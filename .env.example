# Application
NODE_ENV=development
API_PORT=3000
LOCAL_MAIL_DOMAIN=niti
PUBLIC_WEBHOOK_BASE_URL=

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/syscall

# Redis
REDIS_URL=redis://redis:6379

# Authentication
SESSION_TTL_DAYS=30
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_FAILED_ATTEMPTS_PER_DAY=3
PASSWORD_RESET_EXPIRY_HOURS=2

# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP
SMTP_HOST=smtp
SMTP_PORT=2525
SMTP_MAX_MESSAGE_SIZE_MB=25

# Attachments
MAX_ATTACHMENT_SIZE_MB=10
ATTACHMENT_STORAGE_PATH=/var/lib/syscall/attachments
RAW_MAIL_STORAGE_PATH=/var/lib/syscall/raw-mail

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
