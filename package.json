{
  "name": "syscall",
  "private": true,
  "version": "0.1.0",
  "description": "Syscall local PhoneMail backend foundation",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "api": "tsx apps/api/src/index.ts",
    "smtp": "tsx apps/smtp/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "status": "tsx scripts/status.ts",
    "telnyx:config": "tsx scripts/telnyx-config.ts",
    "tailscale:funnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tailscale-funnel.ps1",
    "tailscale:funnel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tailscale-funnel.ps1 -Status",
    "tailscale:funnel:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tailscale-funnel.ps1 -Reset"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.1",
    "mailparser": "^3.7.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "smtp-server": "^3.13.6",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.16",
    "@types/smtp-server": "^3.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
